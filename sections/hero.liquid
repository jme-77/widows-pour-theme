{% assign desktop_bg = section.settings.bg_image | image_url: width: 2560 %}
{% assign mobile_bg = section.settings.bg_image_mobile | image_url: width: 900 %}

<style>
  .wp-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #111;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ desktop_bg }}');
    {% endif %}
  }

  .wp-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.22);
    z-index: 1;
  }

  .wp-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 860px;
    padding: 2rem;
    color: #fff;
  }

  .wp-hero__logo img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto 1.25rem;
  }

  .wp-hero__tagline {
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    color: #f5ead8;
  }

  @media (max-width: 768px) {
    .wp-hero {
      min-height: 100svh;
      {% if section.settings.bg_image_mobile != blank %}
        background-image: url('{{ mobile_bg }}');
      {% elsif section.settings.bg_image != blank %}
        background-image: url('{{ desktop_bg }}');
      {% endif %}
    }
  }
</style>

<section class="wp-hero">
  <div class="wp-hero__overlay"></div>

  <div class="wp-hero__content">
    {% if section.settings.hero_logo != blank %}
      <div class="wp-hero__logo">
        <img
          src="{{ section.settings.hero_logo | image_url: width: 800 }}"
          alt="{{ section.settings.hero_logo.alt | default: 'Hero Graphic' }}"
          loading="eager"
          width="{{ section.settings.hero_logo.width }}"
          height="{{ section.settings.hero_logo.height }}"
        >
      </div>
    {% endif %}

    {% if section.settings.tagline != blank %}
      <p class="wp-hero__tagline">{{ section.settings.tagline }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile"
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "Hero Graphic / Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Luxury candles forged from grief."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
{%- liquid
  if section.settings.bg_image != blank
    assign desktop_bg = section.settings.bg_image | image_url: width: 2560
  else
    assign desktop_bg = 'widows-pour-final-hero.png' | asset_url
  endif

  if section.settings.bg_image_mobile != blank
    assign mobile_bg = section.settings.bg_image_mobile | image_url: width: 900
  else
    assign mobile_bg = desktop_bg
  endif
-%}

<style>
  .wp-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0d0a07;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    overflow: hidden;
    /* Force complete HTTPS protocol to bypass local iframe browser blocks */
    background-image: url('https:{{ desktop_bg }}');
  }

  .wp-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.28) 45%, rgba(0,0,0,0.72) 100%);
    z-index: 1;
  }

  .wp-hero__content {
    position: relative;
    z-index: 2;
    width: min(92%, 760px);
    padding: clamp(2rem, 3.5vw, 3.5rem);
    text-align: center;
    color: #f7ebd9;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 24px;
    background: rgba(13, 10, 7, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 22px 70px rgba(0,0,0,0.28);
  }

  .wp-hero__logo img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto 1.3rem;
  }

  .wp-hero__tagline {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: #f7ebd9;
    text-shadow: 0 2px 18px rgba(0,0,0,0.35);
  }

  /* QA UI Helper Placeholder */
  .wp-hero__logo-placeholder {
    display: block;
    border: 1px dashed rgba(247, 235, 217, 0.4);
    padding: 15px;
    margin-bottom: 1.3rem;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: rgba(247, 235, 217, 0.6);
  }

  @media (max-width: 768px) {
    .wp-hero {
      min-height: 100svh;
      background-image: url('https:{{ mobile_bg }}');
    }

    .wp-hero__content {
      width: min(92%, 680px);
      padding: 1.6rem 1.2rem;
      border-radius: 18px;
    }
  }
</style>

<section class="wp-hero">
  <div class="wp-hero__content">
    {% if section.settings.hero_logo != blank %}
      <div class="wp-hero__logo">
        <img
          src="{{ section.settings.hero_logo | image_url: width: 900 }}"
          alt="{{ section.settings.hero_logo.alt | default: 'Hero Graphic' }}"
          loading="eager"
          width="{{ section.settings.hero_logo.width | default: 900 }}"
          height="{{ section.settings.hero_logo.height | default: 450 }}"
        >
      </div>
    {% else %}
      {% if request.design_mode %}
        <div class="wp-hero__logo-placeholder">
          [ Select Hero Logo in Customizer ]
        </div>
      {% endif %}
    {% endif %}

    {% if section.settings.tagline != blank %}
      <p class="wp-hero__tagline">{{ section.settings.tagline }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile"
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "Hero Graphic / Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Luxury candles forged from grief."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

{% comment %}
  Determine Desktop and Mobile image pathways safely.
  Uses absolute asset paths if no custom image is provided by the merchant.
{% endcomment %}
{%- liquid
  if section.settings.bg_image != blank
    assign desktop_bg = section.settings.bg_image | image_url: width: 2560
  else
    assign desktop_bg = 'widows-pour-final-hero.png' | asset_url
  endif

  if section.settings.bg_image_mobile != blank
    assign mobile_bg = section.settings.bg_image_mobile | image_url: width: 1000
  else
    assign mobile_bg = desktop_bg
  endif

  assign eyebrow = section.settings.eyebrow | default: 'Built on Strength'
  assign heading = section.settings.heading | default: 'Widow’s Pour'
  assign subheading = section.settings.subheading | default: 'Luxury candles forged from grief.'
-%}

<style>
  .wp-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0d0a07;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    overflow: hidden;
    /* CSS Variables scoped directly within the block component rules */
    background-image: url('https:{{ desktop_bg }}');
  }

  .wp-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.28) 45%, rgba(0,0,0,0.72) 100%);
    z-index: 1;
  }

  .wp-hero__content {
    position: relative;
    z-index: 2;
    width: min(92%, 760px);
    padding: clamp(2rem, 3.5vw, 3.5rem);
    text-align: center;
    color: #f7ebd9;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 24px;
    background: rgba(13, 10, 7, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 22px 70px rgba(0,0,0,0.28);
  }

  .wp-hero__eyebrow {
    display: inline-block;
    margin-bottom: 0.8rem;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c9a84c;
  }

  .wp-hero__heading {
    margin: 0 0 0.9rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;
    color: #f7ebd9;
  }

  .wp-hero__subheading {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: #f7ebd9;
  }

  @media (max-width: 768px) {
    .wp-hero {
      min-height: 100svh;
      background-image: url('https:{{ mobile_bg }}');
    }
  }
</style>

<section class="wp-hero">
  <div class="wp-hero__content">
    {%- if eyebrow != blank -%}
      <p class="wp-hero__eyebrow">{{ eyebrow }}</p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 class="wp-hero__heading">{{ heading }}</h1>
    {%- endif -%}

    {%- if subheading != blank -%}
      <p class="wp-hero__subheading">{{ subheading }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Widow's Pour Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built on Strength"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Widow’s Pour"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury candles forged from grief."
    }
  ],
  "presets": [
    {
      "name": "Widow's Pour Hero"
    }
  ]
}
{% endschema %}

<style>
  .shopify-section:has(.wp-hero) {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }
</style>

<section class="wp-hero"
  style="
    --hero-bg-desktop: url('{{ section.settings.bg_image | image_url: width: 2560 }}');
    --hero-bg-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 900 }}');
  "
>
  <!-- Background + overlay -->
  <div class="wp-hero__bg"></div>
  <div class="wp-hero__overlay"></div>

  <!-- Smoke layer -->
  <div class="wp-hero__smoke"></div>

  <!-- Ornaments -->
  <div class="wp-hero__ornament wp-hero__ornament--tl">✦</div>
  <div class="wp-hero__ornament wp-hero__ornament--tr">✦</div>
  <div class="wp-hero__ornament wp-hero__ornament--bl">✦</div>
  <div class="wp-hero__ornament wp-hero__ornament--br">✦</div>

  <!-- Content -->
  <div class="wp-hero__content wp-fade-up">
    {% if section.settings.hero_logo != blank %}
      <div class="wp-hero__logo wp-fade-up-2">
        <img 
          src="{{ section.settings.hero_logo | image_url: width: 800 }}"
          alt="{{ section.settings.hero_logo.alt | default: 'Hero Graphic' }}"
        >
      </div>
    {% endif %}

    {% if section.settings.tagline != blank %}
      <p class="wp-hero__tagline wp-fade-up-3">{{ section.settings.tagline }}</p>
    {% endif %}
  </div>

  <!-- Scroll indicator -->
  <div class="wp-hero__scroll wp-fade-up-4">
    <div class="wp-hero__scroll-line"></div>
    <div class="wp-hero__scroll-label">Scroll</div>
  </div>
</section>

<style>
  @keyframes wpHeroFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .wp-hero {
    position: relative !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100vh;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation: wpHeroFadeIn 1.8s ease forwards;
    background-image: var(--hero-bg-desktop);
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
  }

  {% unless request.design_mode %}
  .wp-hero {
    width: 100vw !important;
    max-width: 100vw !important;
    left: 50%;
    transform: translateX(-50%);
  }
  {% endunless %}

  {% if request.design_mode %}
  .wp-hero {
    width: 100% !important;
    max-width: 100% !important;
  }
  {% endif %}

  @media (max-width: 768px) {
    .wp-hero {
      background-image: var(--hero-bg-mobile);
      background-position: center top !important;
      min-height: 100svh;
      height: 100svh;
    }
  }

  .wp-hero__bg {
    position: absolute;
    inset: 0;
    background-image: var(--hero-bg-desktop);
    background-size: cover;
    background-position: center;
    opacity: 0.18;
  }

  @media (max-width: 768px) {
    .wp-hero__bg {
      background-image: var(--hero-bg-mobile);
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile"
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "Hero Graphic / Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Luxury candles forged from grief."
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}

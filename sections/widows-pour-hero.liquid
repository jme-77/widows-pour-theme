{% assign desktop_bg = section.settings.bg_image | image_url: width: 2560 %}
{% if section.settings.bg_image == blank %}
  {% assign desktop_bg = 'widows-pour-final-hero.png' | asset_url %}
{% endif %}

{% assign mobile_bg = section.settings.bg_image_mobile | image_url: width: 900 %}
{% if section.settings.bg_image_mobile == blank %}
  {% assign mobile_bg = desktop_bg %}
{% endif %}

{% assign eyebrow = section.settings.eyebrow | default: 'Built on Strength' %}
{% assign heading = section.settings.heading | default: 'Widow’s Pour' %}
{% assign subheading = section.settings.subheading | default: section.settings.tagline | default: 'Luxury candles forged from grief.' %}
{% assign btn_label = section.settings.btn_primary_label | default: section.settings.btn_label | default: 'Shop Now' %}
{% assign btn_link = section.settings.btn_primary_link | default: '/collections/all' %}
{% assign btn_bg = section.settings.btn_primary_bg | default: '#c9a84c' %}
{% assign btn_text = section.settings.btn_primary_text | default: '#0d0a07' %}
{% assign overlay_color = section.settings.overlay_color | default: '#000000' %}
{% assign overlay_opacity = section.settings.overlay_opacity | default: 20 %}

<style>
  .wp-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0d0a07;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    overflow: hidden;
    background-image: url('{{ desktop_bg }}');
  }

  .wp-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.26) 45%, rgba(0,0,0,0.72) 100%);
    z-index: 1;
  }

  .wp-hero__content {
    position: relative;
    z-index: 2;
    width: min(92%, 760px);
    padding: clamp(2rem, 3.5vw, 3.5rem);
    text-align: center;
    color: #f7ebd9;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 24px;
    background: rgba(13, 10, 7, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 22px 70px rgba(0,0,0,0.28);
  }

  .wp-hero__eyebrow {
    display: inline-block;
    margin-bottom: 0.8rem;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c9a84c;
  }

  .wp-hero__heading {
    margin: 0 0 0.9rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;
    color: #f7ebd9;
  }

  .wp-hero__subheading {
    margin: 0 0 1.2rem;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: #f7ebd9;
  }

  .wp-hero__button {
    display: inline-block;
    padding: 0.9rem 1.35rem;
    border-radius: 999px;
    background: {{ btn_bg }};
    color: {{ btn_text }};
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .wp-hero {
      min-height: 100svh;
      background-image: url('{{ mobile_bg }}');
    }

    .wp-hero__content {
      width: min(92%, 680px);
      padding: 1.6rem 1.2rem;
      border-radius: 18px;
    }
  }
</style>

<section class="wp-hero">
  <div class="wp-hero__content">
    {% if eyebrow != blank %}
      <p class="wp-hero__eyebrow">{{ eyebrow }}</p>
    {% endif %}

    {% if heading != blank %}
      <h1 class="wp-hero__heading">{{ heading }}</h1>
    {% endif %}

    {% if subheading != blank %}
      <p class="wp-hero__subheading">{{ subheading }}</p>
    {% endif %}

    {% if btn_label != blank and btn_link != blank %}
      <a class="wp-hero__button" href="{{ btn_link }}">{{ btn_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Widow's Pour Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built on Strength"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Widow’s Pour"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury candles forged from grief."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline (fallback)",
      "default": "Luxury candles forged from grief."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Button background",
      "default": "#c9a84c"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Button text",
      "default": "#0d0a07"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Widow's Pour Hero"
    }
  ]
}
{% endschema %}
<style>
  /* Base Hero Container */
  .wp-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-image: var(--hero-bg-desktop);
    animation: wpHeroFadeIn 1.8s ease forwards;
  }

  @keyframes wpHeroFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Content Wrapper */
  .wp-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 90%;
    max-width: 800px;
  }

  .wp-hero__logo {
    width: 100%;
    margin-bottom: 20px;
  }

  .wp-hero__logo img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .wp-hero__tagline {
    font-size: 1.2rem;
    margin-top: 10px;
    color: white;
  }

  /* Decorative Elements */
  .wp-hero__bg {
    position: absolute;
    inset: 0;
    background-image: var(--hero-bg-desktop);
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    pointer-events: none;
  }

  .wp-hero__smoke { position: absolute; inset: 0; z-index: 1; }

  .wp-hero__ornament { position: absolute; font-size: 2rem; color: rgba(255,255,255,0.5); }
  .wp-hero__ornament--tl { top: 20px; left: 20px; }
  .wp-hero__ornament--tr { top: 20px; right: 20px; }
  .wp-hero__ornament--bl { bottom: 20px; left: 20px; }
  .wp-hero__ornament--br { bottom: 20px; right: 20px; }

  /* Mobile Responsive Overrides */
  @media (max-width: 768px) {
    .wp-hero {
      background-image: var(--hero-bg-mobile);
      min-height: 100svh;
    }
    .wp-hero__bg {
      background-image: var(--hero-bg-mobile);
    }
    .wp-hero__logo {
      width: 85%;
    }
  }

  /* Design Mode Breakout Wrapper Fix */
  {% unless request.design_mode %}
  .wp-hero-wrapper {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
  {% endunless %}
</style>

<div class="wp-hero-wrapper">
  <section class="wp-hero"
    style="
      {% if section.settings.bg_image != blank %}
        --hero-bg-desktop: url('{{ section.settings.bg_image | image_url: width: 2560 }}');
      {% else %}
        --hero-bg-desktop: #111111;
      {% endif %}
      
      {% if section.settings.bg_image_mobile != blank %}
        --hero-bg-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 900 }}');
      {% else %}
        --hero-bg-mobile: var(--hero-bg-desktop);
      {% endif %}
    "
  >
    <div class="wp-hero__bg"></div>
    <div class="wp-hero__smoke"></div>

    <div class="wp-hero__ornament wp-hero__ornament--tl">✦</div>
    <div class="wp-hero__ornament wp-hero__ornament--tr">✦</div>
    <div class="wp-hero__ornament wp-hero__ornament--bl">✦</div>
    <div class="wp-hero__ornament wp-hero__ornament--br">✦</div>

    <div class="wp-hero__content">
      {% if section.settings.hero_logo != blank %}
        <div class="wp-hero__logo">
          <img 
            src="{{ section.settings.hero_logo | image_url: width: 800 }}" 
            alt="{{ section.settings.hero_logo.alt | default: 'Hero Graphic' }}"
            loading="eager"
            width="{{ section.settings.hero_logo.width }}"
            height="{{ section.settings.hero_logo.height }}"
          >
        </div>
      {% endif %}

      {% if section.settings.tagline != blank %}
        <p class="wp-hero__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background image — Desktop" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Background image — Mobile" },
    { "type": "image_picker", "id": "hero_logo", "label": "Hero Graphic / Logo" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Luxury candles forged from grief." }
  ],
  "presets": [ { "name": "Hero Banner" } ]
}
{% endschema %}
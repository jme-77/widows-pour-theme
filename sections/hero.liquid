<style>
  /* Force the Shopify section wrapper itself to be full width */
  .shopify-section:has(.wp-hero) {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }
</style>

<section class="wp-hero"
  style="
    --hero-bg-desktop: url('{{ section.settings.bg_image | image_url: width: 2560 }}');
    --hero-bg-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 900 }}');
    background-image: url('{{ section.settings.bg_image | image_url: width: 2560 }}');
  "
>
  <div class="wp-hero__overlay"></div>

  <div class="wp-hero__content">
    {% if section.settings.hero_logo != blank %}
      <div class="wp-hero__logo">
        <img 
          src="{{ section.settings.hero_logo | image_url: width: 800 }}"
          alt="{{ section.settings.hero_logo.alt | default: 'Hero Graphic' }}"
          style="max-width: 100%; height: auto; display: block;"
        >
      </div>
    {% endif %}

    {% if section.settings.tagline != blank %}
      <p class="wp-hero__tagline">{{ section.settings.tagline }}</p>
    {% endif %}
  </div>
</section>

<style>
  @keyframes wpHeroFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .wp-hero {
    position: relative;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100vh;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation: wpHeroFadeIn 1.8s ease forwards;
    background-image: var(--hero-bg-desktop) !important;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
    background-attachment: scroll !important;
  }

  /* Full-bleed breakout — live storefront only */
  {% unless request.design_mode %}
  .wp-hero {
    width: 100vw !important;
    max-width: 100vw !important;
    left: 50%;
    transform: translateX(-50%);
  }
  {% endunless %}

  /* Editor mode — contained width so it renders in the iframe */
  {% if request.design_mode %}
  .wp-hero {
    width: 100% !important;
    max-width: 100% !important;
  }
  {% endif %}

  @media (max-width: 768px) {
    .wp-hero {
      background-image: var(--hero-bg-mobile) !important;
      background-position: center top !important;
    }
  }

  .wp-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 0;
  }

  .wp-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    min-height: 80vh;
  }

  .wp-hero__logo {
    margin-bottom: 2.5rem;
    width: 100%;
    max-width: 600px;
  }

  .wp-hero__tagline {
    font-size: clamp(0.9rem, 3.5vw, 1.15rem);
    color: rgba(255, 255, 255, 0.85);
    max-width: 480px;
    line-height: 1.6;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop",
      "info": "Recommended: 2560×1080px JPG"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile",
      "info": "Recommended: 900×1200px JPG. If left blank, desktop image is used."
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "Hero Graphic / Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Luxury candles forged from grief."
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}